<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TaskFlow - 每日與未來待辦事項管理</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #475569;
        }
        /* Custom animations */
        .task-item {
            transition: all 0.2s ease-in-out;
        }
        .task-item:hover {
            transform: translateY(-1px);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-screen font-sans antialiased flex flex-col transition-colors duration-200">

    <!-- Header Navigation -->
    <header class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Title -->
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-brand-600 text-white rounded-xl shadow-md shadow-brand-500/20">
                        <i data-lucide="check-square" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-xl tracking-tight bg-gradient-to-r from-brand-600 to-indigo-600 bg-clip-text text-transparent dark:from-brand-500 dark:to-indigo-400">
                            TaskFlow
                        </h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400 hidden sm:block">每日待辦與未來排程中心</p>
                    </div>
                </div>

                <!-- Global Controls (Date, Mode, Import/Export) -->
                <div class="flex items-center gap-2 sm:gap-4">
                    <div class="text-right hidden md:block">
                        <div id="current-date-text" class="text-sm font-semibold text-slate-700 dark:text-slate-200"></div>
                        <div id="greeting-text" class="text-xs text-slate-500 dark:text-slate-400">祝您有高效率的一天！</div>
                    </div>

                    <div class="h-8 w-[1px] bg-slate-200 dark:bg-slate-700 hidden md:block"></div>

                    <!-- Action buttons -->
                    <button id="btn-theme-toggle" class="p-2 rounded-lg text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700 transition" title="切換深淺模式">
                        <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                        <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                    </button>
                    
                    <button id="btn-export-data" class="p-2 rounded-lg text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700 transition" title="備份資料 (JSON)">
                        <i data-lucide="download" class="w-5 h-5"></i>
                    </button>

                    <label class="p-2 rounded-lg text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700 transition cursor-pointer" title="匯入資料">
                        <i data-lucide="upload" class="w-5 h-5"></i>
                        <input type="file" id="import-file" accept=".json" class="hidden">
                    </label>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col md:flex-row gap-6">

        <!-- Left Sidebar: Views, Filters, Quick Add Trigger -->
        <aside class="w-full md:w-64 flex-shrink-0 flex flex-col gap-6">
            
            <!-- Quick Add Button -->
            <button id="btn-open-add-modal" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-medium py-3 px-4 rounded-xl shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2 transition active:scale-95">
                <i data-lucide="plus-circle" class="w-5 h-5"></i>
                <span>新增待辦事項</span>
            </button>

            <!-- Navigation Tabs -->
            <nav class="bg-white dark:bg-slate-800 rounded-2xl p-3 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-row md:flex-col gap-1">
                <button data-view="today" class="nav-btn active w-full flex items-center justify-between p-2.5 rounded-xl font-medium text-sm transition">
                    <div class="flex items-center gap-3">
                        <i data-lucide="sun" class="w-4 h-4 text-amber-500"></i>
                        <span>今天必須處理</span>
                    </div>
                    <span id="badge-today-count" class="px-2 py-0.5 text-xs rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 font-bold">0</span>
                </button>

                <button data-view="upcoming" class="nav-btn w-full flex items-center justify-between p-2.5 rounded-xl font-medium text-sm transition text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50">
                    <div class="flex items-center gap-3">
                        <i data-lucide="calendar" class="w-4 h-4 text-brand-500"></i>
                        <span>未來規劃項目</span>
                    </div>
                    <span id="badge-upcoming-count" class="px-2 py-0.5 text-xs rounded-full bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300 font-semibold">0</span>
                </button>

                <button data-view="all" class="nav-btn w-full flex items-center justify-between p-2.5 rounded-xl font-medium text-sm transition text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50">
                    <div class="flex items-center gap-3">
                        <i data-lucide="layers" class="w-4 h-4 text-purple-500"></i>
                        <span>全部任務總覽</span>
                    </div>
                    <span id="badge-all-count" class="px-2 py-0.5 text-xs rounded-full bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300 font-semibold">0</span>
                </button>

                <button data-view="completed" class="nav-btn w-full flex items-center justify-between p-2.5 rounded-xl font-medium text-sm transition text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50">
                    <div class="flex items-center gap-3">
                        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-500"></i>
                        <span>已完成紀錄</span>
                    </div>
                    <span id="badge-completed-count" class="px-2 py-0.5 text-xs rounded-full bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300 font-semibold">0</span>
                </button>
            </nav>

            <!-- Filters Section -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-700/80 shadow-sm space-y-4">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 flex items-center gap-1.5">
                    <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                    標籤與優先級篩選
                </h3>

                <!-- Priority Filter -->
                <div>
                    <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1.5">優先級</label>
                    <select id="filter-priority" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg p-2 text-xs text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <option value="all">所有優先級</option>
                        <option value="high">高 (High)</option>
                        <option value="medium">中 (Medium)</option>
                        <option value="low">低 (Low)</option>
                    </select>
                </div>

                <!-- Category Filter -->
                <div>
                    <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1.5">分類標籤</label>
                    <select id="filter-category" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg p-2 text-xs text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <option value="all">所有分類</option>
                        <option value="Work">💼 工作 (Work)</option>
                        <option value="Personal">🏠 個人 (Personal)</option>
                        <option value="Study">📚 學習 (Study)</option>
                        <option value="Shopping">🛒 購物 (Shopping)</option>
                        <option value="Health">❤️ 健康 (Health)</option>
                        <option value="Finance">💰 財務 (Finance)</option>
                    </select>
                </div>

                <!-- Reset Filters Button -->
                <button id="btn-reset-filters" class="w-full py-1.5 text-xs text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 underline text-center block">
                    重置所有篩選器
                </button>
            </div>

            <!-- Progress Dashboard Card -->
            <div class="bg-gradient-to-br from-brand-500 to-indigo-600 rounded-2xl p-4 text-white shadow-md">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs font-medium text-brand-100">今日完成率</span>
                    <span id="today-progress-percent" class="text-sm font-bold">0%</span>
                </div>
                <div class="w-full bg-brand-700/50 rounded-full h-2 mb-3 overflow-hidden">
                    <div id="today-progress-bar" class="bg-white h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="today-progress-status" class="text-xs text-brand-100">開始規劃您今天的事項吧！</p>
            </div>
        </aside>

        <!-- Right Content: Task Header, Search Bar & Task List -->
        <section class="flex-1 flex flex-col gap-4 min-w-0">

            <!-- Search and Action Bar -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-3 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col sm:flex-row items-center gap-3">
                <!-- Search Box -->
                <div class="relative w-full flex-1">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="search-input" placeholder="搜尋待辦事項標題或內容..." class="w-full pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500 transition">
                </div>

                <!-- Sorting and Quick Actions -->
                <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                    <select id="sort-by" class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-700 dark:text-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <option value="dueDate-asc">📅 到期日 (近到遠)</option>
                        <option value="dueDate-desc">📅 到期日 (遠到近)</option>
                        <option value="priority-desc">🔥 優先級 (高到低)</option>
                        <option value="created-desc">🆕 最新建立</option>
                    </select>

                    <button id="btn-clear-completed" class="p-2 text-xs text-slate-500 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 dark:text-slate-400 rounded-xl border border-slate-200 dark:border-slate-700 transition flex items-center gap-1 flex-shrink-0" title="清除已完成的項目">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">清除已完成</span>
                    </button>
                </div>
            </div>

            <!-- Current View Section Header -->
            <div class="flex items-center justify-between px-1">
                <div>
                    <h2 id="view-title" class="text-xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                        今日必須處理
                    </h2>
                    <p id="view-subtitle" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">今天到期或已過期未完成的事項</p>
                </div>
                <div id="filtered-count" class="text-xs font-medium text-slate-400">共 0 項</div>
            </div>

            <!-- Task List Container -->
            <div id="task-list" class="space-y-3 flex-1">
                <!-- Task items rendered dynamically by JS -->
            </div>

            <!-- Empty State Display -->
            <div id="empty-state" class="hidden flex-1 flex flex-col items-center justify-center p-12 text-center bg-white dark:bg-slate-800 rounded-2xl border border-dashed border-slate-200 dark:border-slate-700">
                <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-400 mb-4">
                    <i data-lucide="inbox" class="w-8 h-8"></i>
                </div>
                <h3 class="text-lg font-semibold text-slate-700 dark:text-slate-200 mb-1">目前沒有符合要求的待辦事項</h3>
                <p class="text-sm text-slate-400 max-w-sm mb-6">點擊「新增待辦事項」或是調整篩選條件來檢視其他任務。</p>
                <button id="btn-empty-add" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-sm font-medium transition flex items-center gap-2">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    新增任務
                </button>
            </div>

        </section>
    </main>

    <!-- Modal Form for Adding/Editing Tasks -->
    <div id="task-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-200 p-4">
        <div class="bg-white dark:bg-slate-800 w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 overflow-hidden transform scale-95 transition-transform duration-200 modal-box">
            
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                <h3 id="modal-title" class="font-bold text-lg text-slate-800 dark:text-slate-100 flex items-center gap-2">
                    <i data-lucide="plus-circle" class="w-5 h-5 text-brand-600"></i>
                    新增待辦事項
                </h3>
                <button id="btn-close-modal" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 rounded-lg">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Form -->
            <form id="task-form" class="p-6 space-y-4">
                <input type="hidden" id="task-id">

                <!-- Title Input -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">任務標題 *</label>
                    <input type="text" id="task-title-input" required placeholder="例如：準備本周開會簡報..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>

                <!-- Category & Priority Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">分類標籤</label>
                        <select id="task-category-input" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            <option value="Work">💼 工作 (Work)</option>
                            <option value="Personal" selected>🏠 個人 (Personal)</option>
                            <option value="Study">📚 學習 (Study)</option>
                            <option value="Shopping">🛒 購物 (Shopping)</option>
                            <option value="Health">❤️ 健康 (Health)</option>
                            <option value="Finance">💰 財務 (Finance)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">優先程度</label>
                        <select id="task-priority-input" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">
                            <option value="low">🟢 低 (Low)</option>
                            <option value="medium" selected>🟡 中 (Medium)</option>
                            <option value="high">🔴 高 (High)</option>
                        </select>
                    </div>
                </div>

                <!-- Due Date & Time -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">預計到期日期與時間 *</label>
                    <input type="datetime-local" id="task-duedate-input" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>

                <!-- Description / Notes -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 mb-1">詳細說明 / 備註 (選填)</label>
                    <textarea id="task-desc-input" rows="3" placeholder="添加更多與任務相關的補充細節..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"></textarea>
                </div>

                <!-- Modal Actions -->
                <div class="pt-3 flex justify-end gap-3 border-t border-slate-100 dark:border-slate-700">
                    <button type="button" id="btn-cancel-modal" class="px-4 py-2 text-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl transition">
                        取消
                    </button>
                    <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-xl shadow-md transition">
                        儲存任務
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notification Toast Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Application Script -->
    <script>
        // State Management
        let tasks = [];
        let currentView = 'today'; // 'today', 'upcoming', 'all', 'completed'
        let filters = {
            search: '',
            priority: 'all',
            category: 'all',
            sortBy: 'dueDate-asc'
        };

        // Category config for styling & icons
        const categoryConfig = {
            Work: { name: '工作', icon: 'briefcase', bg: 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300' },
            Personal: { name: '個人', icon: 'home', bg: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' },
            Study: { name: '學習', icon: 'book-open', bg: 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300' },
            Shopping: { name: '購物', icon: 'shopping-cart', bg: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' },
            Health: { name: '健康', icon: 'heart', bg: 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300' },
            Finance: { name: '財務', icon: 'dollar-sign', bg: 'bg-teal-100 text-teal-800 dark:bg-teal-300 dark:text-teal-300' }
        };

        // Priority config
        const priorityConfig = {
            high: { label: '高', bg: 'bg-red-500', text: 'text-red-500', border: 'border-l-red-500' },
            medium: { label: '中', bg: 'bg-amber-500', text: 'text-amber-500', border: 'border-l-amber-500' },
            low: { label: '低', bg: 'bg-emerald-500', text: 'text-emerald-500', border: 'border-l-emerald-500' }
        };

        // DOM Elements
        const taskListEl = document.getElementById('task-list');
        const emptyStateEl = document.getElementById('empty-state');
        const taskModalEl = document.getElementById('task-modal');
        const taskFormEl = document.getElementById('task-form');

        // Initialize App
        window.onload = function() {
            initTheme();
            loadTasks();
            setupDateDisplay();
            setupEventListeners();
            render();
            lucide.createIcons();
        };

        // Setup Header Date
        function setupDateDisplay() {
            const now = new Date();
            const options = { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' };
            document.getElementById('current-date-text').textContent = now.toLocaleDateString('zh-TW', options);
        }

        // Theme Initialization & Switch
        function initTheme() {
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }

        document.getElementById('btn-theme-toggle').addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });

        // Load & Save LocalStorage
        function loadTasks() {
            const stored = localStorage.getItem('taskflow_tasks');
            if (stored) {
                try {
                    tasks = JSON.parse(stored);
                } catch (e) {
                    tasks = [];
                }
            } else {
                // Seed initial data if first time
                tasks = getSeedTasks();
                saveTasks();
            }
        }

        function saveTasks() {
            localStorage.setItem('taskflow_tasks', JSON.stringify(tasks));
            render();
        }

        function getSeedTasks() {
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            return [
                {
                    id: '1',
                    title: '完成今日工作成果範例整理',
                    category: 'Work',
                    priority: 'high',
                    dueDate: new Date(today.setHours(17, 0, 0, 0)).toISOString().slice(0, 16),
                    description: '整理團隊週會需要報告的專案細節與成果。',
                    completed: false,
                    createdAt: new Date().toISOString()
                },
                {
                    id: '2',
                    title: '預約下週健康檢查',
                    category: 'Health',
                    priority: 'medium',
                    dueDate: new Date(tomorrow.setHours(10, 30, 0, 0)).toISOString().slice(0, 16),
                    description: '確認時間並完成網路線上掛號預約。',
                    completed: false,
                    createdAt: new Date().toISOString()
                },
                {
                    id: '3',
                    title: '購買週末家庭聚餐食材',
                    category: 'Shopping',
                    priority: 'low',
                    dueDate: new Date(tomorrow.setHours(18, 0, 0, 0)).toISOString().slice(0, 16),
                    description: '購買新鮮蔬菜、肉類與飲品。',
                    completed: false,
                    createdAt: new Date().toISOString()
                }
            ];
        }

        // Date Helpers
        function isToday(dateStr) {
            if (!dateStr) return false;
            const d = new Date(dateStr);
            const now = new Date();
            return d.getDate() === now.getDate() &&
                   d.getMonth() === now.getMonth() &&
                   d.getFullYear() === now.getFullYear();
        }

        function isUpcoming(dateStr) {
            if (!dateStr) return false;
            const d = new Date(dateStr);
            const todayEnd = new Date();
            todayEnd.setHours(23, 59, 59, 999);
            return d > todayEnd;
        }

        function isOverdue(dateStr, completed) {
            if (!dateStr || completed) return false;
            const d = new Date(dateStr);
            const now = new Date();
            return d < now && !isToday(dateStr);
        }

        // Main Render Function
        function render() {
            updateBadges();
            updateTodayProgress();
            
            // Filter Tasks based on current view and search/filter inputs
            let filtered = tasks.filter(task => {
                // View filter
                if (currentView === 'today') {
                    // Today or Overdue (uncompleted)
                    if (task.completed) return isToday(task.dueDate);
                    return isToday(task.dueDate) || isOverdue(task.dueDate, task.completed);
                } else if (currentView === 'upcoming') {
                    return isUpcoming(task.dueDate) && !task.completed;
                } else if (currentView === 'completed') {
                    return task.completed;
                }
                return true; // 'all'
            });

            // Priority filter
            if (filters.priority !== 'all') {
                filtered = filtered.filter(t => t.priority === filters.priority);
            }

            // Category filter
            if (filters.category !== 'all') {
                filtered = filtered.filter(t => t.category === filters.category);
            }

            // Search Filter
            if (filters.search.trim() !== '') {
                const q = filters.search.toLowerCase();
                filtered = filtered.filter(t => 
                    t.title.toLowerCase().includes(q) || 
                    (t.description && t.description.toLowerCase().includes(q))
                );
            }

            // Sorting
            filtered.sort((a, b) => {
                if (filters.sortBy === 'dueDate-asc') {
                    return new Date(a.dueDate) - new Date(b.dueDate);
                } else if (filters.sortBy === 'dueDate-desc') {
                    return new Date(b.dueDate) - new Date(a.dueDate);
                } else if (filters.sortBy === 'priority-desc') {
                    const weight = { high: 3, medium: 2, low: 1 };
                    return weight[b.priority] - weight[a.priority];
                } else if (filters.sortBy === 'created-desc') {
                    return new Date(b.createdAt) - new Date(a.createdAt);
                }
                return 0;
            });

            // Render Count Info
            document.getElementById('filtered-count').textContent = `共 ${filtered.length} 項`;

            // Render Task Items or Empty State
            if (filtered.length === 0) {
                taskListEl.innerHTML = '';
                emptyStateEl.classList.remove('hidden');
            } else {
                emptyStateEl.classList.add('hidden');
                taskListEl.innerHTML = filtered.map(task => createTaskHTML(task)).join('');
            }

            // Re-initialize Lucide Icons for dynamic content
            lucide.createIcons();
        }

        // HTML Template for a Task Item
        function createTaskHTML(task) {
            const isTaskOverdue = isOverdue(task.dueDate, task.completed);
            const cat = categoryConfig[task.category] || categoryConfig.Personal;
            const prio = priorityConfig[task.priority] || priorityConfig.medium;

            const formattedDueDate = task.dueDate ? new Date(task.dueDate).toLocaleString('zh-TW', {
                month: 'short',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            }) : '未設日期';

            return `
                <div class="task-item bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-700/80 border-l-4 ${prio.border} shadow-sm hover:shadow-md flex items-start justify-between gap-3 ${task.completed ? 'opacity-60 bg-slate-50/50 dark:bg-slate-800/40' : ''}">
                    <div class="flex items-start gap-3 flex-1 min-w-0">
                        <!-- Custom Checkbox -->
                        <button onclick="toggleTaskCompletion('${task.id}')" class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-lg border-2 ${task.completed ? 'bg-emerald-500 border-emerald-500 text-white' : 'border-slate-300 dark:border-slate-600 hover:border-brand-500'} flex items-center justify-center transition">
                            ${task.completed ? '<i data-lucide="check" class="w-3.5 h-3.5 stroke-[3]"></i>' : ''}
                        </button>

                        <div class="flex-1 min-w-0">
                            <!-- Title & Priority -->
                            <div class="flex items-center gap-2 flex-wrap">
                                <h4 class="text-sm font-semibold text-slate-800 dark:text-slate-100 ${task.completed ? 'line-through text-slate-400 dark:text-slate-500' : ''}">
                                    ${escapeHTML(task.title)}
                                </h4>
                            </div>

                            <!-- Optional Description -->
                            ${task.description ? `
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">
                                    ${escapeHTML(task.description)}
                                </p>
                            ` : ''}

                            <!-- Metadata: Category Tag, Due Date, Overdue Indicator -->
                            <div class="flex items-center gap-2 flex-wrap mt-2.5">
                                <span class="inline-flex items-center gap-1 text-[11px] font-medium px-2 py-0.5 rounded-md ${cat.bg}">
                                    <i data-lucide="${cat.icon}" class="w-3 h-3"></i>
                                    ${cat.name}
                                </span>

                                <span class="inline-flex items-center gap-1 text-[11px] ${isTaskOverdue ? 'text-red-500 font-semibold bg-red-50 dark:bg-red-950/40 px-2 py-0.5 rounded-md' : 'text-slate-500 dark:text-slate-400'}">
                                    <i data-lucide="clock" class="w-3 h-3"></i>
                                    ${isTaskOverdue ? '已逾期：' : ''}${formattedDueDate}
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Menu -->
                    <div class="flex items-center gap-1">
                        <button onclick="openEditModal('${task.id}')" class="p-1.5 text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition" title="編輯">
                            <i data-lucide="edit-3" class="w-4 h-4"></i>
                        </button>
                        <button onclick="deleteTask('${task.id}')" class="p-1.5 text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 rounded-lg transition" title="刪除">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        // Render Dashboard Stats and Side Badges
        function updateBadges() {
            const todayCount = tasks.filter(t => !t.completed && (isToday(t.dueDate) || isOverdue(t.dueDate, t.completed))).length;
            const upcomingCount = tasks.filter(t => !t.completed && isUpcoming(t.dueDate)).length;
            const completedCount = tasks.filter(t => t.completed).length;

            document.getElementById('badge-today-count').textContent = todayCount;
            document.getElementById('badge-upcoming-count').textContent = upcomingCount;
            document.getElementById('badge-all-count').textContent = tasks.length;
            document.getElementById('badge-completed-count').textContent = completedCount;
        }

        function updateTodayProgress() {
            const todayTasks = tasks.filter(t => isToday(t.dueDate));
            if (todayTasks.length === 0) {
                document.getElementById('today-progress-percent').textContent = '0%';
                document.getElementById('today-progress-bar').style.width = '0%';
                document.getElementById('today-progress-status').textContent = '今天尚無排程事項';
                return;
            }
            const done = todayTasks.filter(t => t.completed).length;
            const percent = Math.round((done / todayTasks.length) * 100);

            document.getElementById('today-progress-percent').textContent = `${percent}%`;
            document.getElementById('today-progress-bar').style.width = `${percent}%`;
            
            if (percent === 100) {
                document.getElementById('today-progress-status').textContent = '🎉 太棒了！今天的事項全數完成！';
            } else {
                document.getElementById('today-progress-status').textContent = `已完成 ${done} / ${todayTasks.length} 項任務`;
            }
        }

        // Toggle Task Completion
        window.toggleTaskCompletion = function(id) {
            tasks = tasks.map(t => {
                if (t.id === id) {
                    const completed = !t.completed;
                    showToast(completed ? '任務已完成！' : '已重新標記為未完成', 'success');
                    return { ...t, completed };
                }
                return t;
            });
            saveTasks();
        };

        // Delete Task
        window.deleteTask = function(id) {
            tasks = tasks.filter(t => t.id !== id);
            saveTasks();
            showToast('任務已順利刪除', 'info');
        };

        // Modal Operations
        function openModal(isEdit = false) {
            taskModalEl.classList.remove('hidden');
            setTimeout(() => {
                taskModalEl.classList.remove('opacity-0');
                taskModalEl.querySelector('.modal-box').classList.remove('scale-95');
                taskModalEl.querySelector('.modal-box').classList.add('scale-100');
            }, 10);

            document.getElementById('modal-title').innerHTML = isEdit 
                ? '<i data-lucide="edit-3" class="w-5 h-5 text-brand-600"></i> 編輯待辦事項' 
                : '<i data-lucide="plus-circle" class="w-5 h-5 text-brand-600"></i> 新增待辦事項';
            
            lucide.createIcons();
        }

        function closeModal() {
            taskModalEl.querySelector('.modal-box').classList.remove('scale-100');
            taskModalEl.querySelector('.modal-box').classList.add('scale-95');
            taskModalEl.classList.add('opacity-0');
            setTimeout(() => {
                taskModalEl.classList.add('hidden');
                taskFormEl.reset();
                document.getElementById('task-id').value = '';
            }, 200);
        }

        window.openEditModal = function(id) {
            const task = tasks.find(t => t.id === id);
            if (!task) return;

            document.getElementById('task-id').value = task.id;
            document.getElementById('task-title-input').value = task.title;
            document.getElementById('task-category-input').value = task.category;
            document.getElementById('task-priority-input').value = task.priority;
            document.getElementById('task-duedate-input').value = task.dueDate;
            document.getElementById('task-desc-input').value = task.description || '';

            openModal(true);
        };

        // Form Submission
        taskFormEl.addEventListener('submit', (e) => {
            e.preventDefault();
            const id = document.getElementById('task-id').value;
            const title = document.getElementById('task-title-input').value.trim();
            const category = document.getElementById('task-category-input').value;
            const priority = document.getElementById('task-priority-input').value;
            const dueDate = document.getElementById('task-duedate-input').value;
            const description = document.getElementById('task-desc-input').value.trim();

            if (id) {
                // Edit mode
                tasks = tasks.map(t => t.id === id ? { ...t, title, category, priority, dueDate, description } : t);
                showToast('更新任務成功！', 'success');
            } else {
                // Create mode
                const newTask = {
                    id: Date.now().toString(),
                    title,
                    category,
                    priority,
                    dueDate,
                    description,
                    completed: false,
                    createdAt: new Date().toISOString()
                };
                tasks.push(newTask);
                showToast('已成功新增待辦事項！', 'success');
            }

            saveTasks();
            closeModal();
        });

        // Event Listeners setup
        function setupEventListeners() {
            // Add Task Buttons
            document.getElementById('btn-open-add-modal').addEventListener('click', () => {
                // Default due date to today 18:00
                const now = new Date();
                now.setHours(18, 0, 0, 0);
                document.getElementById('task-duedate-input').value = now.toISOString().slice(0, 16);
                openModal(false);
            });

            document.getElementById('btn-empty-add').addEventListener('click', () => {
                document.getElementById('btn-open-add-modal').click();
            });

            // Close Modal Buttons
            document.getElementById('btn-close-modal').addEventListener('click', closeModal);
            document.getElementById('btn-cancel-modal').addEventListener('click', closeModal);

            // View Switching Tabs
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.nav-btn').forEach(b => {
                        b.classList.remove('active', 'bg-brand-50', 'text-brand-700', 'dark:bg-slate-700', 'dark:text-brand-400');
                        b.classList.add('text-slate-600', 'dark:text-slate-400');
                    });

                    btn.classList.add('active', 'bg-brand-50', 'text-brand-700', 'dark:bg-slate-700', 'dark:text-brand-400');
                    btn.classList.remove('text-slate-600', 'dark:text-slate-400');

                    currentView = btn.dataset.view;
                    updateViewTitles();
                    render();
                });
            });

            // Filters & Search
            document.getElementById('search-input').addEventListener('input', (e) => {
                filters.search = e.target.value;
                render();
            });

            document.getElementById('filter-priority').addEventListener('change', (e) => {
                filters.priority = e.target.value;
                render();
            });

            document.getElementById('filter-category').addEventListener('change', (e) => {
                filters.category = e.target.value;
                render();
            });

            document.getElementById('sort-by').addEventListener('change', (e) => {
                filters.sortBy = e.target.value;
                render();
            });

            document.getElementById('btn-reset-filters').addEventListener('click', () => {
                filters.search = '';
                filters.priority = 'all';
                filters.category = 'all';
                filters.sortBy = 'dueDate-asc';

                document.getElementById('search-input').value = '';
                document.getElementById('filter-priority').value = 'all';
                document.getElementById('filter-category').value = 'all';
                document.getElementById('sort-by').value = 'dueDate-asc';
                render();
            });

            // Clear Completed Tasks
            document.getElementById('btn-clear-completed').addEventListener('click', () => {
                const count = tasks.filter(t => t.completed).length;
                if (count === 0) {
                    showToast('目前無已完成的任務可清除', 'info');
                    return;
                }
                tasks = tasks.filter(t => !t.completed);
                saveTasks();
                showToast(`已清除 ${count} 項已完成的任務`, 'success');
            });

            // Data Export & Import
            document.getElementById('btn-export-data').addEventListener('click', exportData);
            document.getElementById('import-file').addEventListener('change', importData);
        }

        // View Titles Update
        function updateViewTitles() {
            const titleEl = document.getElementById('view-title');
            const subTitleEl = document.getElementById('view-subtitle');

            if (currentView === 'today') {
                titleEl.innerHTML = `<i data-lucide="sun" class="w-5 h-5 text-amber-500"></i> 今日必須處理`;
                subTitleEl.textContent = '今天到期或已過期未完成的事項';
            } else if (currentView === 'upcoming') {
                titleEl.innerHTML = `<i data-lucide="calendar" class="w-5 h-5 text-brand-500"></i> 未來規劃項目`;
                subTitleEl.textContent = '未來的排程任務規劃與預定事項';
            } else if (currentView === 'all') {
                titleEl.innerHTML = `<i data-lucide="layers" class="w-5 h-5 text-purple-500"></i> 全部任務總覽`;
                subTitleEl.textContent = '顯示所有包含已完成與進行中的事項';
            } else if (currentView === 'completed') {
                titleEl.innerHTML = `<i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500"></i> 已完成紀錄`;
                subTitleEl.textContent = '回溯歷史已完成的事項與成就';
            }
            lucide.createIcons();
        }

        // Toast Message Notification
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const bgClass = type === 'success' 
                ? 'bg-emerald-600 text-white' 
                : type === 'error' 
                ? 'bg-red-600 text-white' 
                : 'bg-slate-800 text-white';

            toast.className = `${bgClass} px-4 py-2 rounded-xl shadow-xl text-xs font-medium flex items-center gap-2 pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-200`;
            toast.innerHTML = `
                <i data-lucide="${type === 'success' ? 'check-circle' : 'info'}" class="w-4 h-4"></i>
                <span>${message}</span>
            `;

            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 200);
            }, 3000);
        }

        // Export JSON Data
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(tasks, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `TaskFlow_Backup_${new Date().toISOString().slice(0, 10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
            showToast('已匯出資料備份檔', 'success');
        }

        // Import JSON Data
        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedTasks = JSON.parse(e.target.result);
                    if (Array.isArray(importedTasks)) {
                        tasks = importedTasks;
                        saveTasks();
                        showToast('成功匯入備份資料！', 'success');
                    } else {
                        showToast('匯入失敗：檔案格式不符合需求', 'error');
                    }
                } catch (err) {
                    showToast('無法解析檔案內容', 'error');
                }
            };
            reader.readAsText(file);
        }

        // Helper: Escape HTML string
        function escapeHTML(str) {
            if (!str) return '';
            return str.replace(/[&<>'"]/g, 
                tag => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    "'": '&#39;',
                    '"': '&quot;'
                }[tag] || tag)
            );
        }
    </script>
</body>
</html>
